    "elysia": "^1.4.0",
    "inngest": "^3.44.0",
    "resend": "^6.0.0",
    "tldts": "^7.4.11"
  },
  "devDependencies": {
    "@ownsi/tsconfig": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
