{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ownsi-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    // origem do Cloud Run; /api/* e /p/* são proxiados para cá (PRD §3.1)
    "API_ORIGIN": "https://ownsi-api-xxxxx.a.run.app"
  }
}
