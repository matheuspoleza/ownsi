# ─── Banco (Neon) ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/ownsi?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/ownsi?sslmode=require"

# ─── API ───────────────────────────────────────────────────────────────────────
PORT="3000"
APP_URL="http://localhost:5173"
CHALLENGE_PREFIX="_ownsi-challenge"

# ─── Auth (better-auth) ────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:5173"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── E-mail (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="ownsi <no-reply@ownsi.dev>"

# ─── Relógio (Inngest) ─────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ─── DNS ───────────────────────────────────────────────────────────────────────
# vazio = DoH real; "fake" usa as respostas gravadas em apps/api/test/fixtures
DNS_DRIVER="doh"
