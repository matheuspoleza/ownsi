# ─── Database ──────────────────────────────────────────────────────────────────
# dev: the docker-compose Postgres. prod: the Neon URL.
DATABASE_URL="postgresql://ownsi:ownsi@localhost:5432/ownsi"
DIRECT_URL="postgresql://ownsi:ownsi@localhost:5432/ownsi"

# ─── API ───────────────────────────────────────────────────────────────────────
PORT="3000"
APP_URL="http://localhost:5173"
CHALLENGE_PREFIX="_ownsi-challenge"

# ─── Clock (Inngest) ───────────────────────────────────────────────────────────
# dev points at the docker-compose Dev Server; prod uses the cloud keys
# "inngest" = the durable scheduler; "manual" = nothing is scheduled, you press check
INNGEST_DRIVER="inngest"
INNGEST_DEV="1"
INNGEST_BASE_URL="http://localhost:8288"
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ─── Auth (better-auth) ────────────────────────────────────────────────────────
# required; `openssl rand -base64 32`. Google is optional — both halves or neither.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:5173"
MAGIC_LINK_TTL_SECONDS="600"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Email (Resend) ────────────────────────────────────────────────────────────
# "resend" = real sending, needs a verified domain; "log" = print the subject to stdout
MAILER_DRIVER="log"
RESEND_API_KEY=""
EMAIL_FROM="ownsi <no-reply@ownsi.dev>"

# ─── DNS ───────────────────────────────────────────────────────────────────────
# "doh" = real resolvers; "fake" = recorded answers
DNS_DRIVER="doh"
DNS_RESOLVER_TIMEOUT_MS="4000"
ZONE_CACHE_TTL_SECONDS="300"
SOA_BUDGET_MS="2500"
AUTHORITATIVE_BUDGET_MS="2500"

# ─── Domains ───────────────────────────────────────────────────────────────────
# "postgres" = claims start empty; "demo" = a claim on a name from the catalogue
# opens with the history that screen is meant to show
DOMAINS_DRIVER="postgres"
