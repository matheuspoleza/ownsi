# Copy to .env. Every value below already points at what `bun run setup` starts,
# except BETTER_AUTH_SECRET — that one you have to fill in.

# ─── Auth (better-auth) ────────────────────────────────────────────────────────
# Required. Generate one: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:5173"
MAGIC_LINK_TTL_SECONDS="600"
# Google sign-in is optional: both halves, or neither.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Email (Resend) ────────────────────────────────────────────────────────────
# "log" prints the whole email to the terminal, sign-in link included — sign in
# locally by copying that link. "resend" sends for real and needs a verified domain.
MAILER_DRIVER="log"
RESEND_API_KEY=""
EMAIL_FROM="ownsi <no-reply@ownsi.dev>"

# ─── Database ──────────────────────────────────────────────────────────────────
# dev: the docker-compose Postgres. prod: the Neon URL.
DATABASE_URL="postgresql://ownsi:ownsi@localhost:5432/ownsi"
DIRECT_URL="postgresql://ownsi:ownsi@localhost:5432/ownsi"

# ─── API ───────────────────────────────────────────────────────────────────────
PORT="3000"
APP_URL="http://localhost:5173"
CHALLENGE_PREFIX="_ownsi-challenge"

# ─── Clock (Inngest) ───────────────────────────────────────────────────────────
# The docker-compose Dev Server; prod uses the cloud keys instead.
# "inngest" = claims re-check on their own. "manual" = nothing is scheduled and
# you drive every check from the *check now* button.
INNGEST_DRIVER="inngest"
INNGEST_DEV="1"
INNGEST_BASE_URL="http://localhost:8288"
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ─── DNS ───────────────────────────────────────────────────────────────────────
# "doh" = real resolvers. "fake" = the recorded answers the tests replay.
DNS_DRIVER="doh"
DNS_RESOLVER_TIMEOUT_MS="4000"
ZONE_CACHE_TTL_SECONDS="300"
SOA_BUDGET_MS="2500"
AUTHORITATIVE_BUDGET_MS="2500"
