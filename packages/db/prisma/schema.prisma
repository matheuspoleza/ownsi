generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClaimState {
  PENDING
  PROVED
  EXPIRED
  DORMANT
  ARCHIVED
}

model Claim {
  id          String     @id @default(cuid())
  domainAscii String     @unique
  state       ClaimState @default(PENDING)
  createdAt   DateTime   @default(now())
}

/// `requestedName` is what a caller asked about; `name` is the zone that answered, which
/// may be a parent of it.
model Zone {
  requestedName           String   @id
  name                    String
  nameservers             String[]
  provider                String
  negativeCacheTtlSeconds Int?
  serial                  BigInt?
  observedAt              DateTime

  @@index([name])
  @@index([observedAt])
}
