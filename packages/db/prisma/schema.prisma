generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClaimState {
  PENDING
  PROVED
  EXPIRED
  CANCELED
}

enum NoticeKind {
  PROVED
  NUDGE
  EXPIRING
  COEXISTENCE
}

enum VerificationMethod {
  DNS_TXT
}

enum VerificationStatus {
  RUNNING
  PROVED
  EXHAUSTED
  STOPPED
}

enum AttemptTrigger {
  FIRST_CHECK
  SCHEDULED
  REQUESTED
}

enum AttemptOutcome {
  FOUND
  ABSENT
  UNRESOLVABLE
}

/// One account's involvement with one name. The same name is claimable by other
/// accounts at the same time — coexistence is read across rows, never enforced away.
model Domain {
  id          String    @id
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nameAscii   String
  nameUnicode String
  archivedAt  DateTime?
  createdAt   DateTime
  claims      Claim[]

  @@unique([userId, nameAscii])
  @@index([nameAscii])
}

/// `sequence` orders the claims of a domain; the highest is the one in play, the
/// rest are history. A claim is never reopened, so the order never changes.
model Claim {
  id             String        @id
  sequence       Int           @default(autoincrement())
  domainId       String
  domain         Domain        @relation(fields: [domainId], references: [id], onDelete: Cascade)
  userId         String
  token          String
  state          ClaimState
  expiresAt      DateTime
  endedAt        DateTime?
  verificationId String?
  createdAt      DateTime
  notices        ClaimNotice[]
  verification   Verification?

  @@index([domainId, sequence])
  @@index([userId, state])
}

/// What we have already said about a claim, so that nothing is said twice inside a day.
model ClaimNotice {
  id      String     @id
  claimId String
  claim   Claim      @relation(fields: [claimId], references: [id], onDelete: Cascade)
  notice  NoticeKind
  sentAt  DateTime

  @@index([claimId, notice, sentAt])
}

/// The process that runs until the challenge is found or the deadline passes. The
/// column is `claimId` because there is one database; the code calls it a subject,
/// and verification never reads the row it points at.
model Verification {
  id                  String                @id
  claimId             String                @unique
  claim               Claim                 @relation(fields: [claimId], references: [id], onDelete: Cascade)
  ownerId             String
  method              VerificationMethod
  challenge           Json
  status              VerificationStatus
  deadline            DateTime
  nextRunAt           DateTime?
  consecutiveFailures Int                   @default(0)
  lastOutcome         AttemptOutcome?
  lastRunAt           DateTime?
  lastDiagnosis       Json?
  createdAt           DateTime
  attempts            VerificationAttempt[]

  @@index([ownerId])
  @@index([status, nextRunAt])
}

/// Append-only. No path ends a claim as proved without one of these rows written in
/// the same transaction.
model VerificationAttempt {
  id             String         @id
  verificationId String
  verification   Verification   @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  trigger        AttemptTrigger
  outcome        AttemptOutcome
  diagnosis      Json?
  evidence       Json?
  latencyMs      Int?
  createdAt      DateTime

  @@index([verificationId, createdAt])
}

/// `requestedName` is what a caller asked about; `name` is the zone that answered, which
/// may be a parent of it.
model Zone {
  requestedName           String   @id
  name                    String
  nameservers             String[]
  provider                String
  negativeCacheTtlSeconds Int?
  serial                  BigInt?
  observedAt              DateTime

  @@index([name])
  @@index([observedAt])
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  domains       Domain[]
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

/// better-auth's own table, named so that `Verification` can mean the product's.
model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
