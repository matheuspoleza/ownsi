// ownsi schema. The full model lives in PRD §3.5 — this is only what the vertical
// slice (front → API → database) needs to stand up.
// Connection URLs live in prisma.config.ts (Prisma 7).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClaimState {
  PENDING
  PROVED
  EXPIRED
  DORMANT
  ARCHIVED
}

model Claim {
  id          String     @id @default(cuid())
  domainAscii String     @unique
  state       ClaimState @default(PENDING)
  createdAt   DateTime   @default(now())
}

